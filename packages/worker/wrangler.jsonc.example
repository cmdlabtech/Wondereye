{
  "name": "wondereye-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    { "pattern": "api.wondereye.app", "custom_domain": true }
  ],
  // Feedback (POST /api/feedback) — see docs/feedback.md. ALLOWED_ORIGIN
  // (existing, set as before) must include https://wondereye.app.
  // Secrets (never in this file): wrangler secret put TURNSTILE_SECRET
  //                               wrangler secret put GITHUB_FEEDBACK_TOKEN
  "vars": {
    "FEEDBACK_ENABLED": "false",
    "TURNSTILE_HOSTNAMES": "wondereye.app",
    "FEEDBACK_REPO": "cmdlabtech/Wondereye"
  },
  "kv_namespaces": [
    {
      "binding": "LANDMARKS_CACHE",
      "id": "YOUR_KV_NAMESPACE_ID",
      "preview_id": "local-dev-cache"
    }
  ]
}
