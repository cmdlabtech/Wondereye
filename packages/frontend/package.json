{
  "name": "wondereye-frontend",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "build:ehpk": "vite build --mode ehpk --base ./ --outDir dist-ehpk",
    "pack": "npm run build:ehpk && cp dist-ehpk/app.html dist-ehpk/index.html && evenhub pack app.json dist-ehpk -o wondereye.ehpk && rm -rf dist-ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.11",
    "@evenrealities/evenhub-simulator": "^0.7.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.13",
    "@types/node": "^25.6.0",
    "@types/three": "^0.185.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "wrangler": "^4.84.1"
  }
}
