{
  "name": "wondereye-frontend",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "node ../../scripts/compose-site.mjs && wrangler deploy",
    "build:ehpk": "vite build --mode ehpk --base ./ --outDir dist-ehpk",
    "pack": "npm run build:ehpk && cp dist-ehpk/app.html dist-ehpk/index.html && node ../../scripts/check-ehpk-urls.mjs app.json dist-ehpk && evenhub pack app.json dist-ehpk --sdk-ver 0.0.14 -o wondereye.ehpk && rm -rf dist-ehpk",
    "test": "vitest run"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.14",
    "@evenrealities/pretext": "^0.1.4",
    "@types/leaflet.markercluster": "^1.5.6",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^3.2.7",
    "wrangler": "^4.84.1"
  }
}
